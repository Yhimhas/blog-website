{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "pnpm run check:content && vite build",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "test:content": "node --experimental-strip-types --test scripts/content.test.mjs",
    "test:music": "node --experimental-strip-types --test scripts/music-api.test.mjs scripts/music-library.test.mjs scripts/music-recommendations.test.mjs scripts/music-daily.test.mjs scripts/music-playback.test.mjs scripts/music-view.test.mjs",
    "test:blog": "node --experimental-strip-types --test scripts/blog-api.test.mjs scripts/seo-publication.test.mjs scripts/admin-seo-view.test.mjs scripts/admin-session-view.test.mjs",
    "test:seo": "node --experimental-strip-types --test scripts/seo.test.mjs",
    "test:seo:build": "node --experimental-strip-types --test scripts/seo-build.test.mjs",
    "type-check": "vue-tsc --build",
    "sync:music": "node scripts/sync-bilibili.mjs"
  },
  "dependencies": {
    "@field-lab/vue": "file:vendor\\field-lab-vue-0.1.2.tgz",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
