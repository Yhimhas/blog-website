# Documentation only: the executable reads process environment, not .env files.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8081
DATABASE_URL=postgres://blog_user:REPLACE_LOCALLY@127.0.0.1:5432/blog?sslmode=disable
ALLOWED_ORIGIN=http://localhost:5173
SESSION_TTL=24h
COOKIE_SECURE=false
DEMO_MODE=false
# Explicit opt-in: public NetEase metadata may be denied by the upstream.
MUSIC_AUTO_SYNC=false
# Disabled until real browser and target-server acceptance passes.
MUSIC_PLAYBACK_ENABLED=false
MUSIC_MEDIA_ADDR=127.0.0.1:8082
MUSIC_YTDLP=yt-dlp

# FFmpeg receives only validated pipe input; MP3 output is 128 kbps.
MUSIC_FFMPEG=ffmpeg
# Optional compatibility mode: also convert MP3 / AAC-M4A to MP3.
MUSIC_FORCE_TRANSCODE=false

# Anonymous public audio remains the default; account audio needs explicit grants.
MUSIC_PLAYBACK_POLICY=public_only
MUSIC_REQUIRE_FULL=false
# Absolute paths to operator-controlled files OUTSIDE the repository/web root.
MUSIC_NETEASE_COOKIE_FILE=
MUSIC_PUBLIC_GRANTS_FILE=
MUSIC_WEB_ROOT=
MUSIC_ACCOUNT_REQUESTS_PER_MINUTE=20
MUSIC_ACCOUNT_REJECT_THRESHOLD=3
MUSIC_ACCOUNT_COOLDOWN=1m
# Trust only an ingress which overwrites X-Forwarded-For, e.g. 127.0.0.1/32,::1/128.
MUSIC_TRUSTED_PROXIES=
MUSIC_OWNER_REQUESTS_PER_MINUTE=10
MUSIC_IP_REQUESTS_PER_MINUTE=10
MUSIC_MAX_SESSIONS=128
MUSIC_MAX_RESOLVERS=2
MUSIC_MAX_STREAMS=4
MUSIC_MAX_TRANSCODERS=2
MUSIC_MAX_STREAM_BYTES=268435456
MUSIC_HOURLY_BYTES=1073741824
MUSIC_MAX_STREAM_DURATION=6h
