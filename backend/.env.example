# Documentation only: the executable reads process environment, not .env files.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8081
DATABASE_URL=postgres://blog_user:REPLACE_LOCALLY@127.0.0.1:5432/blog?sslmode=disable
ALLOWED_ORIGIN=http://localhost:5173
SESSION_TTL=24h
COOKIE_SECURE=false
DEMO_MODE=false
# Explicit opt-in: public NetEase metadata may be denied by the upstream.
MUSIC_AUTO_SYNC=false
