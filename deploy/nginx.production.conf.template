worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format blog '$remote_addr $request_method $uri $status';
    access_log /dev/stdout blog;
    sendfile on;
    server_tokens off;
    client_max_body_size 256k;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    server {
        listen __BIND_IP__:8088;
        server_name __BIND_IP__;
        return 308 https://__BIND_IP__:8443$request_uri;
    }
    server {
        listen __BIND_IP__:8443 ssl;
        server_name __BIND_IP__;
        ssl_certificate /tls/site.crt;
        ssl_certificate_key /tls/site.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        root /site/current;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        location ^~ /api/v1/music/streams/ {
            proxy_pass http://127.0.0.1:8082;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_max_temp_file_size 0;
            gzip off;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
            send_timeout 60s;
            access_log off;
            error_log /dev/null crit;
        }
        location ^~ /api/v1/music/playback-sessions {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_cache off;
            access_log off;
            error_log /dev/null crit;
        }
        location ^~ /api/ {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_cache off;
            proxy_read_timeout 30s;
        }
        location ^~ /assets/ {
            root /site;
            try_files $uri =404;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy strict-origin-when-cross-origin always;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
        location = /seo-release.json { return 404; }
        location / {
            open_file_cache off;
            try_files $uri/index.html $uri =404;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy strict-origin-when-cross-origin always;
            add_header Cache-Control no-cache always;
        }
        error_page 404 /404.html;
        location = /404.html {
            internal;
            open_file_cache off;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy strict-origin-when-cross-origin always;
            add_header X-Robots-Tag noindex always;
            add_header Cache-Control no-cache always;
        }
        location = /index.html { return 301 /$is_args$args; }
        location ~ ^(.+)/index\.html$ { return 301 $1$is_args$args; }
        location ~ ^(.+)/$ { return 301 $1$is_args$args; }
    }
}
