# Build the Go executables into runtime/bin before building this image.
# tooling/pnpm.tgz is the verified registry archive; tooling/yt-dlp is the
# existing operator-provided executable. Neither contains site credentials.
FROM node:24-alpine

ARG APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
RUN ALPINE_SERIES=$(cut -d. -f1,2 /etc/alpine-release) \
    && printf '%s/v%s/main\n%s/v%s/community\n' "$APK_MIRROR" "$ALPINE_SERIES" "$APK_MIRROR" "$ALPINE_SERIES" > /etc/apk/repositories \
    && apk add --no-cache ca-certificates ffmpeg python3
COPY tooling/pnpm.tgz /tmp/pnpm.tgz
COPY deploy/pnpm-launcher.sh /usr/local/bin/pnpm
RUN mkdir -p /opt/pnpm \
    && tar -xzf /tmp/pnpm.tgz -C /opt/pnpm --strip-components=1 \
    && chmod 0755 /usr/local/bin/pnpm \
    && pnpm --version

WORKDIR /opt/blog/frontend
COPY frontend/ ./
RUN pnpm install --frozen-lockfile \
    && pnpm run type-check \
    && pnpm run test:blog \
    && pnpm run test:music \
    && pnpm run test:seo \
    && chown -R 1000:1000 /opt/blog/frontend

COPY runtime/bin/ /opt/blog/bin/
COPY tooling/yt-dlp /usr/local/bin/yt-dlp
COPY deploy/start-seo-refresh.mjs /opt/blog/start-seo-refresh.mjs
RUN chmod 0755 /opt/blog/bin/* /usr/local/bin/yt-dlp \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libmp3lame \
    && yt-dlp --version

USER 1000:1000
ENV pnpm_config_verify_deps_before_run=false
CMD ["/opt/blog/bin/api"]
