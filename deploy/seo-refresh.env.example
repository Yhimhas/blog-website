# Loaded by systemd, not by the API. Paths resolve from the service WorkingDirectory.
# Use the SAME database as the API. Keep this file outside the web root, mode 0600.
DATABASE_URL=postgres://blog_user:REPLACE_LOCALLY@127.0.0.1:5432/blog?sslmode=disable
VITE_SITE_URL=https://your-domain.example
SEO_API_ORIGIN=http://127.0.0.1:8081
SEO_FRONTEND_DIR=frontend
SEO_RELEASES_DIR=../seo-site/releases
SEO_CURRENT_LINK=../seo-site/current
SEO_ASSETS_DIR=../seo-site/assets
SEO_BUILD_TIMEOUT=5m
# pnpm >=11.19.0 (engines.pnpm in frontend/package.json) and supported Node.js must be on this PATH.
PATH=/usr/local/bin:/usr/bin:/bin
